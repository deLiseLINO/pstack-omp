# worktree-audit.sh, the one upstream script the port changes, and every change to it is code
# rather than prose, so a unified diff is the right layer for all of it.
#
# The changes, all of them code:
#   - read the omp session store, keyed by cwd the way omp keys it, instead of Cursor's
#     slugified per-project directory, and move stat and date onto their GNU spellings
#   - parse `git worktree list` records by stripping the record prefix, so a path containing
#     spaces survives, and report a lock reason in its own LOCKED column
#   - take the scratch file from a per-run directory under a trap, so two concurrent audits
#     cannot collide and the file is removed on every exit path
#   - record an unreadable worktree in a new INSPECT column and bucket it hold-error, rather
#     than letting a failed rev-parse read as a clean tree
#   - never mark a locked or unreadable worktree `safe`
#
# Upstream's -b/--base flag, its origin/HEAD default, its Origin-first PR fetch with the gh
# fallback, its LAST_CHAT column, and its verify-recent-chat bucket are all kept exactly as
# written. playbooks/worktree-cleanup.md names that bucket by name, so replacing it would put the
# port's prose and upstream's out of step.
#
# Authored against post-rules text. rules.sed runs first and rewrites the Cursor path in the
# comment this patch deletes, so a hunk quoting the raw upstream comment would not apply.
--- a/skills/poteto-mode/scripts/worktree-audit.sh
+++ b/skills/poteto-mode/scripts/worktree-audit.sh
--- a/skills/poteto-mode/scripts/worktree-audit.sh
+++ b/skills/poteto-mode/scripts/worktree-audit.sh
--- a/skills/poteto-mode/scripts/worktree-audit.sh
+++ b/skills/poteto-mode/scripts/worktree-audit.sh
@@ -1,8 +1,8 @@
 #!/usr/bin/env bash
 # Read-only worktree prune audit. Classifies every git worktree by size, merge
-# state, uncommitted work, remote/PR state, and the most recent chat that
-# operated in it. Emits a table sorted by size with a suggested bucket. Never
-# deletes anything; deletion stays a human-gated step in the playbook.
+# state, uncommitted work, and remote/PR state. Emits a table sorted by size
+# with a suggested bucket. Never deletes anything; deletion stays a
+# human-gated step in the playbook.
 #
 # Usage: worktree-audit.sh [-b|--base <ref>] [repo-path]
 #   repo-path defaults to the current repo.
@@ -28,7 +28,12 @@
 git rev-parse --git-dir >/dev/null 2>&1 || { echo "error: not a git repo: $repo" >&2; exit 1; }
 
 # Main worktree is the first entry; everything else is a candidate.
-main_wt=$(git worktree list --porcelain | awk '/^worktree /{print $2; exit}')
+# Strip the record prefix rather than splitting fields, so a path with spaces survives.
+if ! worktree_records=$(git worktree list --porcelain); then
+	echo "could not inspect git worktrees" >&2
+	exit 1
+fi
+main_wt=$(printf '%s\n' "$worktree_records" | awk '/^worktree /{sub(/^worktree /, ""); print; exit}')
 
 if [ -z "$base" ]; then
 	for cand in "$(git symbolic-ref --short refs/remotes/origin/HEAD 2>/dev/null)" origin/main origin/master; do
@@ -50,7 +55,10 @@
 # PR state by branch, fetched once as [{number, state, head}] with a lowercase
 # state. Origin when its CLI can read this repo's PRs, otherwise gh. Empty when
 # neither can.
-prs=$(mktemp)
+scratch_dir="${TMPDIR:-$repo/.pstack-scratch}/worktree-audit"
+mkdir -p "$scratch_dir"
+prs=$(mktemp "$scratch_dir/prs.XXXXXX")
+trap 'rm -f "$prs"' EXIT INT TERM
 if command -v origin >/dev/null 2>&1 \
 	&& raw=$(origin pr list --author "@me" --state all --limit 1000 \
 		--json number,status,headRef 2>/dev/null); then
@@ -61,19 +69,39 @@
 fi
 [ -s "$prs" ] || echo "[]" > "$prs"
 
-# Transcripts dir: ~/.omp/projects/<slugified-repo-path>/agent-transcripts.
-slug=$(printf '%s' "$main_wt" | sed 's#^/##; s#/#-#g')
-transcripts="$HOME/.cursor/projects/$slug/agent-transcripts"
+# omp keys each session tree by cwd. Scan this worktree's bucket and the repo's; walking every
+# bucket would scale with total session history.
+sessions="${PI_CODING_AGENT_DIR:-$HOME/.omp/agent}/sessions"
+bucket() { printf '%s/%s' "$sessions" "$(printf '%s' "${1#"$HOME"}" | sed 's#/#-#g')"; }
+repo_bucket=$(bucket "$main_wt")
+[ -d "$repo_bucket" ] || repo_bucket="$sessions"
 now=$(date +%s)
 
 echo "# base: $base"
-printf "SIZE\tAGE\tMERGED\tDIRTY\tREMOTE\tPR\tLAST_CHAT\tBUCKET\tWORKTREE\n"
+printf "SIZE\tAGE\tMERGED\tDIRTY\tLOCKED\tINSPECT\tREMOTE\tPR\tLAST_CHAT\tBUCKET\tWORKTREE\n"
 
-git worktree list --porcelain | awk '/^worktree /{print $2}' | while read -r wt; do
+printf '%s\n' "$worktree_records" | awk '/^worktree /{sub(/^worktree /, ""); print}' | while IFS= read -r wt; do
+
+	inspect=ok
+	lock=$(printf '%s\n' "$worktree_records" | awk -v target="$wt" '
+		BEGIN { RS=""; FS="\n" }
+		$1 == "worktree " target {
+			for (i = 1; i <= NF; i++) {
+				if ($i ~ /^locked/) {
+					reason = substr($i, 8)
+					print reason == "" ? "yes" : reason
+					exit
+				}
+			}
+		}')
+	[ -z "$lock" ] && lock="-"
 	[ "$wt" = "$main_wt" ] && continue
 
 	size=$(du -sh "$wt" 2>/dev/null | awk '{print $1}')
-	head=$(git -C "$wt" rev-parse HEAD 2>/dev/null)
+	if ! head=$(git -C "$wt" rev-parse HEAD 2>/dev/null); then
+		head=""
+		inspect="head-error"
+	fi
 	head_ts=$(git -C "$wt" log -1 --format='%ct' HEAD 2>/dev/null || echo 0)
 	age=$([ "$head_ts" -gt 0 ] 2>/dev/null && echo "$(( (now - head_ts) / 86400 ))d" || echo "?")
 
@@ -82,8 +110,10 @@
 	git merge-base --is-ancestor "$head" "$base" 2>/dev/null && merged=YES || merged=no
 
 	# Distinguish real WIP (tracked edits) from disposable untracked scratch.
-	porcelain=$(git -C "$wt" status --porcelain 2>/dev/null)
-	if [ -z "$porcelain" ]; then dirty=clean
+	if ! porcelain=$(git -C "$wt" status --porcelain 2>/dev/null); then
+		dirty=error
+		inspect="status-error"
+	elif [ -z "$porcelain" ]; then dirty=clean
 	elif printf '%s\n' "$porcelain" | grep -qv '^??'; then
 		dirty="wip:$(printf '%s\n' "$porcelain" | grep -cv '^??')"
 	else dirty="scratch:$(printf '%s\n' "$porcelain" | grep -c '^??')"; fi
@@ -103,24 +133,33 @@
 	# Most recent chat whose transcript operated in this worktree. Match path
 	# followed by "/" or a quote so glint-482 does not match glint-482-r37.
 	last="-"; last_ts=0
-	if [ -d "$transcripts" ]; then
-		f=$(rg -l -e "${wt}/" -e "${wt}\"" "$transcripts" 2>/dev/null \
-			| xargs stat -f '%m %N' 2>/dev/null | sort -rn | head -1)
+	wt_bucket=$(bucket "$wt"); [ -d "$wt_bucket" ] || wt_bucket="$repo_bucket"
+	if [ -d "$repo_bucket" ]; then
+		f=$(rg -l -e "${wt}/" -e "${wt}\"" "$repo_bucket" "$wt_bucket" 2>/dev/null \
+			| xargs -r stat -c '%Y %n' 2>/dev/null | sort -rn | head -1)
 		if [ -n "$f" ]; then last_ts=$(echo "$f" | awk '{print $1}')
-			last=$(date -r "$last_ts" '+%Y-%m-%d' 2>/dev/null); fi
+			last=$(date -d @"$last_ts" '+%Y-%m-%d' 2>/dev/null); fi
 	fi
 	recent=$([ "$last_ts" -gt 0 ] 2>/dev/null && [ $(( (now - last_ts) / 86400 )) -le 4 ] && echo yes || echo no)
 
-	case "$dirty" in wip:*) bucket=hold-wip ;; *)
-		case "$pr" in */open|*/draft) bucket=hold-open-pr ;; *)
-			if [ "$recent" = yes ]; then bucket=verify-recent-chat
-			elif [ "$merged" = YES ] || [ "$pr" != "-" ]; then bucket=safe
-			else bucket=review; fi ;;
-		esac ;;
-	esac
+	if [ "$inspect" != ok ]; then bucket=hold-error
+	elif [ "$lock" != "-" ]; then bucket=hold-locked
+	else
+		case "$dirty" in
+		error) bucket=hold-error ;;
+		wip:*) bucket=hold-wip ;;
+		*)
+			case "$pr" in
+			*OPEN*) bucket=hold-open-pr ;;
+			*)
+				if [ "$recent" = yes ]; then bucket=verify-recent-chat
+				elif [ "$merged" = YES ] || [ "$pr" != "-" ]; then bucket=safe
+				else bucket=review; fi ;;
+			esac ;;
+		esac
+	fi
 
 	printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" \
 		"$size" "$age" "$merged" "$dirty" "$remote" "$pr" "$last" "$bucket" "$wt"
 done | sort -t$'\t' -k1,1 -rh
 
-rm -f "$prs"
